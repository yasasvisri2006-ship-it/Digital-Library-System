{
  "name": "server",
  "version": "1.0.0",
  "description": "Digital Library System backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node --check src/server.js",
    "test": "node --test",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "node prisma/seed.js",
    "education:generate": "node prisma/generate-education-assets.js",
    "education:seed": "node prisma/seed-educational-materials.js",
    "education:prepare": "npm run education:generate && npm run education:seed",
    "admin:bootstrap": "node prisma/bootstrap-admin.js",
    "admin:reset-password": "node prisma/reset-admin-password.js",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "library",
    "api",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.6.5"
  },
