PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
DATABASE_URL=postgresql://YOUR_LOCAL_USER:YOUR_URL_ENCODED_PASSWORD@localhost:5432/digital_library?schema=public
NODE_ENV=development
# Set a private 32+ character key to enable one-time /admin/setup in development only.
# Never expose this as a VITE_* variable.
DEMO_STUDENT_ENABLED=false
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
ACADEMIC_RESOURCE_STORAGE_DIR=
# Optional absolute path to the LibreOffice executable; defaults to "soffice" on PATH.
LIBREOFFICE_PATH=
PORTFOLIO_STORAGE_DIR=
# Production uses a private object-storage provider; local storage is for development only.
ACADEMIC_RESOURCE_STORAGE_PROVIDER=local
# Optional when using R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Set provider=supabase in production when using the private Supabase Storage bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=academic-files
# Optional isolated Python execution through the Judge0 CE submissions API.
# JUDGE0_API_KEY is required only when the selected endpoint requires X-Auth-Token.
# Keep this credential in the backend environment; never use a VITE_ prefix.
JUDGE0_URL=
JUDGE0_API_KEY=
# Set to the Python 3 language ID enabled by your Judge0 instance.
JUDGE0_PYTHON_LANGUAGE_ID=
